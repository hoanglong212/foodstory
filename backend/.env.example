# Track 2 V3 complete canonical pipeline
VISION_AUTO_YOUTUBE_TRACK2_V3_ENABLED=false
TRACK2_V3_CANONICAL_ORCHESTRATOR_ENABLED=true
TRACK2_V3_SMART_OVERLAY_ENABLED=true
TRACK2_V3_LOCAL_OCR_ENABLED=true
TRACK2_V3_LOCAL_OCR_PROVIDER=ensemble
TRACK2_V3_TESSERACT_ENABLED=true
TRACK2_V3_EASYOCR_ENABLED=false
TRACK2_V3_PADDLEOCR_ENABLED=true
TRACK2_V3_ADAPTIVE_FRAME_SAMPLING_ENABLED=true
TRACK2_V3_TEXT_REGION_PROPOSAL_ENABLED=true
TRACK2_V3_MAX_DYNAMIC_TEXT_REGIONS_PER_FRAME=4
TRACK2_V3_TEMPORAL_EPISODE_ENABLED=true
TRACK2_V3_TEMPORAL_EPISODE_MAX_GAP_SECONDS=2.25
TRACK2_V3_TEMPORAL_EPISODE_MAX_REPRESENTATIVES=12
TRACK2_V3_TEMPORAL_EPISODE_NEIGHBOR_COUNT=2
TRACK2_V3_MAX_SMART_OVERLAY_SELECTED_IMAGES=12
TRACK2_V3_MAX_TESSERACT_DEEP_PASS_IMAGES=6
TRACK2_V3_SMART_OVERLAY_SCORING_CONCURRENCY=8
TRACK2_V3_WINDOWED_ASR_ENABLED=true
# Full-audio fallback policy after windowed ASR / visual evidence analysis:
# - always: legacy behavior; full audio may run whenever late rescue is insufficient.
# - no_visual_text: full audio only when visual OCR produced no text.
# - strong_signal_only: recommended production mode; full audio only when visual or
#   metadata evidence contains a strong/meaningful address partial. Weak unrelated
#   subtitles/menu text can still reach Gemini Crop Judge without spending ~full-video ASR.
TRACK2_V3_ASR_FULL_AUDIO_FALLBACK_POLICY=strong_signal_only
TRACK2_V3_ASR_WINDOW_PADDING_SECONDS=6
TRACK2_V3_ASR_WINDOW_MAX_SECONDS=22
TRACK2_V3_ASR_WINDOW_MAX_COUNT=3

# Track 2 V3 production diagnostics / provider activation. Vision Auto reads
# LOCATION_RESOLUTION_PROVIDER once above; use `geoapify` or `disabled`.
TRACK2_TESSERACT_BIN=
# Optional compatibility alias for the same executable.
TRACK2_V3_TESSERACT_BIN=

