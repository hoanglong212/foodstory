VISION_AUTO_JOB_WORKER_STARTUP_TIMEOUT_MS=5000
VISION_AUTO_JOB_WORKER_HEARTBEAT_TIMEOUT_MS=20000
VISION_AUTO_JOB_WORKER_CLEANUP_GRACE_MS=3000
VISION_DISH_PROMPT_THRESHOLD=
# Explicitly enable dish-to-real-place search after configuring Places API (New).
