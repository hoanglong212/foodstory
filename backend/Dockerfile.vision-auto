# Production runtime for FoodStory Vision Auto.
# It installs the native URL/video/OCR dependencies that a plain Node runtime
# does not provide: yt-dlp, FFmpeg/ffprobe, Tesseract Vietnamese OCR and the
# optional faster-whisper ASR rescue.
FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH=/opt/vision-auto-venv/bin:$PATH \
    TRACK2_YTDLP_BIN=/opt/vision-auto-venv/bin/yt-dlp \
    YOUTUBE_YT_DLP_PATH=/opt/vision-auto-venv/bin/yt-dlp \
    TRACK2_FFMPEG_BIN=/usr/bin/ffmpeg \
    YOUTUBE_FFMPEG_PATH=/usr/bin/ffmpeg \
    TRACK2_FFPROBE_BIN=/usr/bin/ffprobe \
    TRACK2_V3_TESSERACT_BIN=/usr/bin/tesseract \
    TRACK2_TESSERACT_BIN=/usr/bin/tesseract \
    TRACK2_V3_ASR_PYTHON_BIN=/opt/vision-auto-venv/bin/python \
    HF_HOME=/tmp/huggingface \
    XDG_CACHE_HOME=/tmp/cache

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
      ca-certificates \
      ffmpeg \
      libgomp1 \
      python3 \
      python3-venv \
      tesseract-ocr \
      tesseract-ocr-eng \
      tesseract-ocr-vie \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-track2-v3.txt ./
RUN python3 -m venv /opt/vision-auto-venv \
  && /opt/vision-auto-venv/bin/python -m pip install --no-cache-dir --upgrade pip \
  && /opt/vision-auto-venv/bin/python -m pip install --no-cache-dir -r requirements-track2-v3.txt

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts=false \
  && npm cache clean --force

COPY . .

RUN mkdir -p /tmp/huggingface /tmp/cache /app/tmp \
  && chown -R node:node /app /tmp/huggingface /tmp/cache

USER node
EXPOSE 3000
CMD ["npm", "start"]
